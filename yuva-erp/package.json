{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:all": "node scripts/dev.mjs",
    "server": "node scripts/dev.mjs --server-only",
    "build": "vite build",
    "start": "vite build && node scripts/dev.mjs --server-only",
    "test": "node scripts/dev.mjs --test",
    "lint": "tsc --noEmit && tsc -p server_node --noEmit",
    "preview": "vite preview",
    "test:ui": "vitest run",
    "test:all": "npm test && npm run test:ui",
    "migrate": "node server_node/src/migrate.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^5.3.0",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.8.0",
    "nodemailer": "^10.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
