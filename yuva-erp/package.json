{
  "name": "academiaos",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "setup": "npm --prefix frontend install && npm --prefix backend install",
    "dev:all": "node dev.mjs",
    "server": "node dev.mjs --server-only",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run build && node dev.mjs --server-only",
    "test": "npm --prefix backend test",
    "test:ui": "npm --prefix frontend run test:ui",
    "test:all": "npm test && npm run test:ui",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "migrate": "npm --prefix backend run migrate",
    "preview": "npm --prefix frontend run preview"
  },
  "engines": {
    "node": ">=22.18"
  }
}
