# Copy this file to .env and fill in your own MongoDB address. .env is not part of git.
# MongoDB Atlas (free cloud) or your own server:
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/
# Name of the database that AcademiaOS creates and uses
MONGODB_DB=academiaos
# Optional: DB_PORT=3001

# Optional: emails (a coaching is approved or rejected, a leave is asked, an account is made...). A free Gmail works: turn on 2-step verification,
# make an "app password" and use it here. Without these nothing is emailed and the Super Admin gets a WhatsApp button.
# TIP: make a NEW free Gmail only for the product (for example academiaos.app@gmail.com) and use it here, not a personal one. Every email shows
# this address and the name in SMTP_FROM (like the "noreply" address of a big site). SMTP_FROM must use the same address as SMTP_USER.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=AcademiaOS <you@gmail.com>

# Optional: write every email into this file instead of sending it (to try the app without sending real mail).
# MAIL_LOG=./mail.log

# Optional: the address of your site for the links in emails (default: the address the request came to).
# PUBLIC_URL=https://your-site.example.com
